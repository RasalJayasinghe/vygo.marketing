# Optional: live HubSpot EDM data via the server-side proxy.
# HUBSPOT_TOKEN = HubSpot service key (preferred) or legacy private-app token.
# Never prefix this with VITE_ — it must stay server-side only.
VITE_HUBSPOT_ENABLED=false
HUBSPOT_TOKEN=

# Optional: enables webinar and podcast generation in Quick Tools.
ANTHROPIC_API_KEY=
